{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "SimulationEvaluationRecord",
  "required": [
    "schema",
    "evaluation_id",
    "evidence_ref",
    "acceptance_contract",
    "checks",
    "result",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "axiom-simulation/evaluation-record-v1"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_contract": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "passed",
          "observed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "observed": {}
        }
      }
    },
    "result": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "INCONCLUSIVE"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
