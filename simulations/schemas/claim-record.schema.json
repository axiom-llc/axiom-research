{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "EvidenceTraceableClaim",
  "required": [
    "schema",
    "claim_id",
    "claim",
    "scope",
    "evidence_refs",
    "evidence_classification",
    "limitations",
    "publication_surfaces"
  ],
  "properties": {
    "schema": {
      "const": "axiom-simulation/claim-record-v1"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_classification": {
      "enum": [
        "SYNTHETIC_SIMULATION",
        "VALIDATED_EXECUTABLE_DEMO",
        "PRODUCTION_DEPLOYMENT"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "publication_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
