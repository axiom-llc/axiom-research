{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "OperationalCycle",
  "required": [
    "schema",
    "cycle_id",
    "domain",
    "synthetic",
    "days",
    "entities",
    "resources",
    "arrivals",
    "staffing_events",
    "calendar_events",
    "queue_snapshots",
    "resource_contention",
    "ledger_entries",
    "state_snapshots",
    "work_items",
    "outcomes",
    "completeness"
  ],
  "properties": {
    "schema": {
      "const": "axiom-simulation/operational-cycle-v1"
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "arrivals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "staffing_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "calendar_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "queue_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "resource_contention": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "ledger_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "state_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "minProperties": 7
    }
  }
}
