{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "SyntheticFixtureManifest",
  "required": [
    "schema",
    "fixture_id",
    "scenario_id",
    "synthetic",
    "generation_method",
    "seed",
    "source_refs",
    "assumptions",
    "contains_private_data",
    "artifact_hashes"
  ],
  "properties": {
    "schema": {
      "const": "axiom-simulation/fixture-manifest-v1"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "generation_method": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contains_private_data": {
      "const": false
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
