      }
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "intent_id",
    "objective",
    "priority_class",
    "hard_constraints",
    "required_outcome",
    "evidence_requirements",
